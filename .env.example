# 模型（Qwen）
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_MODEL=qwen3.5-plus
QWEN_CODER_MODEL=qwen3-coder-plus

# Hermes（WSL2 + Docker full setup）
HERMES_HOME=/home/<user>/hermes
HERMES_CONTAINER=hermes

# PAST-Bench 路径（WSL 视角；仓库内 submodule 对应 /mnt/c/...）
PAST_BENCH_ROOT=/mnt/c/Users/<user>/Desktop/新人培养/past-bench-memory-evolve/benchmarks/PAST-Bench
